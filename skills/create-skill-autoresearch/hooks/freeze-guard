#!/bin/sh
# Runs freeze_guard.py (beside this file) with the first Python 3.9+ it finds, as hooks/kill-guard does. With none,
# the write is allowed: the guard must never stop every write, and a Cursor permission hook must answer JSON.
guard="${0%freeze-guard}freeze_guard.py"
for py in python3 python; do
  if $py -c 'import sys; sys.exit(sys.version_info < (3, 9))' </dev/null >/dev/null 2>&1; then
    exec $py "$guard"
  fi
done
echo "freeze guard: no Python 3.9+ found (python3, python); write allowed" >&2
input=$(cat)
case $input in
  *'"tool_input"'*) ;;
  *) echo '{"permission": "allow"}' ;;
esac
exit 0
