#!/bin/sh
# Runs kill_guard.py (beside this file) with the first Python 3.9+ it finds (python3, then python). With
# none, the command is allowed: the guard must never stop every shell call, and a Cursor permission hook
# must answer JSON.
guard="${0%kill-guard}kill_guard.py"
for py in python3 python; do
  if $py -c 'import sys; sys.exit(sys.version_info < (3, 9))' </dev/null >/dev/null 2>&1; then
    exec $py "$guard"
  fi
done
echo "kill guard: no Python 3.9+ found (python3, python); command allowed" >&2
input=$(cat)
case $input in
  *'"tool_input"'*) ;;
  *) echo '{"permission": "allow"}' ;;
esac
exit 0
