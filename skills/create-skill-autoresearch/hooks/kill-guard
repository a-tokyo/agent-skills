#!/bin/sh
# Runs kill_guard.py (beside this file) with the first Python 3.9+ it finds: python3, python, then the
# Windows launcher `py -3` (Git Bash on Windows has no python3 when Python came from python.org, and the
# Microsoft Store's python3 stub fails the probe). With none, the command is allowed: the guard must
# never stop every shell call, and a Cursor permission hook must answer JSON.
guard="${0%kill-guard}kill_guard.py"
for py in python3 python "py -3"; do
  if $py -c 'import sys; sys.exit(sys.version_info < (3, 9))' </dev/null >/dev/null 2>&1; then
    exec $py "$guard"
  fi
done
echo "kill guard: no Python 3.9+ found (python3, python, py -3); command allowed" >&2
input=$(cat)
case $input in
  *'"tool_input"'*) ;;
  *) echo '{"permission": "allow"}' ;;
esac
exit 0
